    DECLARE @filterDateTo DATE = CAST(@dateFilterTo AS DATE);·
    SELECT
        rr.ID AS Implementation_External_ID__c,
        ft.ID AS [npsp__Opportunity__r:Opportunity-vnfp__Implementation_External_ID__c],
        rr.CONSTITUENTID AS [npsp__Contact__r:Contact-Auctifera__Implementation_External_ID__c],
        rr.AMOUNT AS npsp__Amount__c,
        'Soft Credit' AS npsp__Role_Name__c
    FROM
        REVENUERECOGNITION rr
    INNER JOIN REVENUERECOGNITIONTYPECODE rrtc
        ON rrtc.ID = rr.REVENUERECOGNITIONTYPECODEID
    INNER JOIN FINANCIALTRANSACTIONLINEITEM li
        ON li.ID = rr.REVENUESPLITID
       AND li.[TYPE] = 'Standard'
    INNER JOIN REVENUESPLIT_EXT rse
        ON rse.ID = li.ID
    INNER JOIN FINANCIALTRANSACTION ft
        ON ft.ID = li.FINANCIALTRANSACTIONID
    INNER JOIN CONSTITUENT recognized_c
        ON recognized_c.ID = rr.CONSTITUENTID
    WHERE
        rrtc.DESCRIPTION IN ('FF Soft Credit', 'Soft Credit')
        AND rse.APPLICATION IN ('Donation', 'Recurring gift', 'Planned gift', 'Matching gift', 'Pledge')
        AND recognized_c.ISORGANIZATION = 0
        AND recognized_c.ISGROUP = 0
        AND (
            @useDateFrom = 0
            OR rr.EFFECTIVEDATE >= @filterDateFrom
        )
        AND (
            @useDateTo = 0
            OR rr.EFFECTIVEDATE < DATEADD(DAY, 1, @filterDateTo)
        )
    ORDER BY
        ft.ID,
        rr.REVENUESPLITID,
        rr.ID;
