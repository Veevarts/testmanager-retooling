            sop.SALESORDERID,
            CASE
                WHEN UPPER(COALESCE(rpm.PAYMENTMETHOD, '')) LIKE '%CREDIT%' THEN 'Credit Card'
                WHEN UPPER(COALESCE(rpm.PAYMENTMETHOD, '')) LIKE '%DEBIT%' THEN 'Debit Card'
                WHEN UPPER(COALESCE(rpm.PAYMENTMETHOD, '')) LIKE '%ACH%'
                  OR UPPER(COALESCE(rpm.PAYMENTMETHOD, '')) LIKE '%DIRECT%' THEN 'ACH'
                WHEN UPPER(COALESCE(rpm.PAYMENTMETHOD, '')) LIKE '%CASH%' THEN 'Cash'
                ELSE NULL
            END AS normalized_payment_method
        FROM SALESORDERPAYMENT sop
        LEFT JOIN REVENUEPAYMENTMETHOD rpm
            ON rpm.REVENUEID = sop.PAYMENTID·
        UNION ALL·
        SELECT
            so.ID AS SALESORDERID,
            CASE
                WHEN UPPER(COALESCE(rpm.PAYMENTMETHOD, '')) LIKE '%CREDIT%' THEN 'Credit Card'
                WHEN UPPER(COALESCE(rpm.PAYMENTMETHOD, '')) LIKE '%DEBIT%' THEN 'Debit Card'
                WHEN UPPER(COALESCE(rpm.PAYMENTMETHOD, '')) LIKE '%ACH%'
                  OR UPPER(COALESCE(rpm.PAYMENTMETHOD, '')) LIKE '%DIRECT%' THEN 'ACH'
                WHEN UPPER(COALESCE(rpm.PAYMENTMETHOD, '')) LIKE '%CASH%' THEN 'Cash'
                ELSE NULL
            END AS normalized_payment_method
        FROM SALESORDER so
        LEFT JOIN REVENUEPAYMENTMETHOD rpm
            ON rpm.REVENUEID = so.REVENUEID
    ),
    payment_method_summary AS (
        SELECT
            SALESORDERID,
            CASE
                WHEN COUNT(DISTINCT normalized_payment_method) = 0 THEN NULL
                WHEN COUNT(DISTINCT normalized_payment_method) = 1 THEN MAX(normalized_payment_method)
                ELSE 'Multiple'
            END AS payment_method
        FROM payment_method_candidates
        WHERE normalized_payment_method IS NOT NULL
        GROUP BY SALESORDERID
    ),
    merchandise_lines AS (
        SELECT
            so.ID AS salesorder_id,
            so.LOOKUPID,
            so.REVENUEID,
            so.SALESMETHODTYPE,
            so.STATUSCODE,
            so.REFUNDSTATUS,
            so.TRANSACTIONDATE,
            so.DATEADDED,
            so.AMOUNT AS salesorder_amount,
            CASE
                WHEN c.ISORGANIZATION = 0
                 AND c.ISGROUP = 0
                 AND c.ISCONSTITUENT = 1 THEN so.CONSTITUENTID
                ELSE NULL
            END AS client_contact_id,
            CASE
                WHEN c.ISORGANIZATION = 1
                  OR c.ISGROUP = 1
                  OR c.ISCONSTITUENT = 0 THEN so.CONSTITUENTID
                ELSE chh.HOUSEHOLDID
            END AS client_account_id,
            addr.POSTCODE,
            CAST(COALESCE(us.unit_rows, soi.QUANTITY, 0) AS INT) AS quantity_bought,
            CAST(COALESCE(us.returned_qty, 0) AS INT) AS refunded_qty,
            COALESCE(us.item_level_discount, ids.total_item_discount, 0) AS item_discount_abs,
            COALESCE(us.order_level_discount, ods.total_order_discount, 0) AS order_discount_abs,
            COALESCE(us.amount_paid_after_discount, soi.TOTAL, 0) AS subtotal_after_discount,
            COALESCE(us.refunded_amount_after_discount, 0) AS subtotal_refunded_after_discount,
            COALESCE(ts.total_tax_pct, 0) AS tax_pct
        FROM SALESORDERITEM soi
        INNER JOIN SALESORDERITEMMERCHANDISE soim
            ON soim.ID = soi.ID
        INNER JOIN SALESORDER so
            ON so.ID = soi.SALESORDERID
        LEFT JOIN ADDRESS addr
            ON addr.ID = so.ADDRESSID
        LEFT JOIN CONSTITUENT c
            ON c.ID = so.CONSTITUENTID
        LEFT JOIN CONSTITUENTHOUSEHOLD chh
            ON chh.ID = so.CONSTITUENTID
        LEFT JOIN item_discount_summary ids
            ON ids.SALESORDERITEMID = soi.ID
        LEFT JOIN order_discount_summary ods
            ON ods.SALESORDERITEMID = soi.ID
        LEFT JOIN tax_summary ts
            ON ts.SALESORDERITEMID = soi.ID
        LEFT JOIN unit_summary us
            ON us.SALESORDERITEMMERCHANDISEID = soim.ID
    ),
    calculated_lines AS (
        SELECT
            ml.*,
            -(COALESCE(ml.item_discount_abs, 0) + COALESCE(ml.order_discount_abs, 0)) AS discount_amount,
            COALESCE(ml.subtotal_after_discount, 0)
                + COALESCE(ml.item_discount_abs, 0)
                + COALESCE(ml.order_discount_abs, 0) AS subtotal_before_discount,
            COALESCE(ml.subtotal_after_discount, 0) AS subtotal_without_tax,
            ROUND(COALESCE(ml.subtotal_after_discount, 0) * COALESCE(ml.tax_pct, 0) / 100.0, 2) AS tax_amount,
            ROUND(
                COALESCE(ml.subtotal_after_discount, 0)
                    + (COALESCE(ml.subtotal_after_discount, 0) * COALESCE(ml.tax_pct, 0) / 100.0),
                2
            ) AS total_amount,
            ROUND(
                COALESCE(ml.subtotal_refunded_after_discount, 0)
                    + (COALESCE(ml.subtotal_refunded_after_discount, 0) * COALESCE(ml.tax_pct, 0) / 100.0),
                2
            ) AS total_refunded_amount
        FROM merchandise_lines ml
    ),
    order_totals AS (
        SELECT
            salesorder_id,
            MAX(LOOKUPID) AS lookup_id_legacy,
            MAX(REVENUEID) AS revenue_id,
            MAX(SALESMETHODTYPE) AS sales_method_type,
            MAX(STATUSCODE) AS status_code,
            MAX(REFUNDSTATUS) AS refund_status,
            MAX(TRANSACTIONDATE) AS transaction_date,
            MAX(DATEADDED) AS date_added,
            MAX(salesorder_amount) AS salesorder_amount,
            MAX(client_contact_id) AS client_contact_id,
            MAX(client_account_id) AS client_account_id,
            MAX(POSTCODE) AS postal_code,
            SUM(quantity_bought) AS items_count,
            SUM(refunded_qty) AS refunded_items_count,
            SUM(subtotal_before_discount) AS subtotal_before_discount,
            SUM(subtotal_without_tax) AS subtotal,
            SUM(total_amount) AS total_amount,
            SUM(total_refunded_amount) AS refunded_amount
        FROM calculated_lines
        GROUP BY salesorder_id
    )
    SELECT
        CAST(ot.salesorder_id AS NVARCHAR(255)) AS Implementation_External_ID__c,
        CASE
            WHEN ot.refund_status IS NOT NULL AND ot.refund_status = 2 THEN 'Refunded'
            WHEN ot.refunded_items_count >= ot.items_count AND ot.items_count > 0 THEN 'Refunded'
            WHEN ot.status_code IN (1, 2, 3, 4) THEN 'Sold'
            WHEN ot.status_code = 5 THEN 'Canceled'
            ELSE 'Pending'
        END AS Auctifera__Status__c,
        ot.sales_method_type AS Auctifera__Source__c,
        ot.client_contact_id AS Auctifera__Client__c,
        ot.client_account_id AS Auctifera__Client2__c,
        pms.payment_method AS Auctifera__Payment_Method__c,
        ot.postal_code AS Auctifera__Postal_Code__c,
        1 AS Auctifera__Prevent_Email_Notification__c,
        CAST(COALESCE(ot.transaction_date, ot.date_added) AS DATE) AS Auctifera__Transaction_Date__c,
        CAST(COALESCE(ot.transaction_date, ot.date_added) AS DATE) AS Auctifera__Sold_Date__c,
        ot.items_count AS Auctifera__Items__c,
        ot.subtotal_before_discount AS Auctifera__Subtotal_before_discount__c,
        ot.subtotal AS Auctifera__Subtotal__c,
        ot.total_amount AS Auctifera__Total__c,
        ot.total_amount AS Auctifera__Amount_Received__c,
        ot.refunded_amount AS Auctifera__Amount_Refunded__c,
        ot.refunded_items_count AS Auctifera__Refunded_Items__c
    FROM order_totals ot
    LEFT JOIN payment_method_summary pms
        ON pms.SALESORDERID = ot.salesorder_id
    WHERE
        (@useDateFrom = 0 OR CAST(COALESCE(ot.transaction_date, ot.date_added) AS DATE) >= @filterDateFrom)
        AND (@useDateTo = 0 OR CAST(COALESCE(ot.transaction_date, ot.date_added) AS DATE) <= @filterDateTo);
    "

