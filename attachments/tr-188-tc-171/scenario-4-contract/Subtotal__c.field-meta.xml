<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Subtotal__c</fullName>
    <description>Resources Rental Subtotal -  Additional Discounts</description>
    <formula>IF(AND(ISNULL(Rental_Resource_Subtotals2__c), NOT(ISNULL(Resources_Rental_Charge__c))),
(Resources_Rental_Charge__c - Resource_Rental_Discounts__c - Additional_Discount__c),
(Rental_Resource_Subtotals2__c - Additional_Discount__c))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Resources Rental Subtotal -  Additional Discounts</inlineHelpText>
    <label>(DEPRECATED) Subtotal</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
